	measure 'PM2.5 Sparkline' =
			VAR LatestDate = CALCULATE(MAX('marts fct_pollution_daily'[date_utc]), ALLSELECTED('marts fct_pollution_daily'))
			VAR StartDate = LatestDate - 13
			VAR TrendTable =
			    ADDCOLUMNS(
			        FILTER(
			            ALL('marts fct_pollution_daily'[date_utc]),
			            'marts fct_pollution_daily'[date_utc] >= StartDate && 'marts fct_pollution_daily'[date_utc] <= LatestDate
			        ),
			        "@Val", CALCULATE(AVERAGE('marts fct_pollution_daily'[avg_pm2_5_ug_m3]))
			    )
			VAR CleanTrend = FILTER(TrendTable, NOT ISBLANK([@Val]))
			VAR PointCount = COUNTROWS(CleanTrend)
			VAR RankedTrend =
			    ADDCOLUMNS(
			        CleanTrend,
			        "@Idx", RANKX(CleanTrend, 'marts fct_pollution_daily'[date_utc],, ASC, Dense) - 1
			    )
			VAR MinY = MINX(RankedTrend, [@Val])
			VAR MaxY = MAXX(RankedTrend, [@Val])
			VAR YRange = IF(MaxY = MinY, 1, MaxY - MinY)
			VAR W = 120
			VAR H = 30
			VAR Pad = 2
			VAR PlotW = W - 2 * Pad
			VAR PlotH = H - 2 * Pad
			VAR PointsStr =
			    CONCATENATEX(
			        RankedTrend,
			        VAR X = Pad + DIVIDE([@Idx], PointCount - 1) * PlotW
			        VAR YNorm = DIVIDE([@Val] - MinY, YRange)
			        VAR Y = Pad + (1 - YNorm) * PlotH
			        RETURN FORMAT(ROUND(X, 2), "General Number", "en-US") & "," & FORMAT(ROUND(Y, 2), "General Number", "en-US")
			        , " ",
			        [@Idx], ASC
			    )
			VAR PrevVal = MAXX(FILTER(RankedTrend, [@Idx] = PointCount - 2), [@Val])
			VAR LastVal = MAXX(FILTER(RankedTrend, [@Idx] = PointCount - 1), [@Val])
			VAR StrokeColor = IF(LastVal <= PrevVal, "%233FB950", "%23F85149")
			VAR AreaPoints = Pad & "," & (H - Pad) & " " & PointsStr & " " & (W - Pad) & "," & (H - Pad)
			VAR SvgRaw =
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & W & " " & H & "' preserveAspectRatio='none'><defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & StrokeColor & "' stop-opacity='0.45'/><stop offset='1' stop-color='" & StrokeColor & "' stop-opacity='0'/></linearGradient></defs><polygon points='" & AreaPoints & "' fill='url(%23g)' stroke='none'/><polyline fill='none' stroke='" & StrokeColor & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' points='" & PointsStr & "'/></svg>"
			RETURN
			IF(PointCount < 2, BLANK(), "data:image/svg+xml;utf8," & SUBSTITUTE(SvgRaw, " ", "%20"))
		lineageTag: d56ef1b2-560d-44e0-a938-a2c8a7e10581
		dataCategory: ImageUrl

