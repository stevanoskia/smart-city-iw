	measure 'Coverage Strip' =
			VAR Cutoff = NOW() - 1
			VAR TotalCities = CALCULATE(DISTINCTCOUNT('marts dim_city'[city]), REMOVEFILTERS('marts dim_city'))
			VAR Slots = GENERATESERIES(0, 23, 1)
			VAR Boxes =
			    CONCATENATEX(
			        Slots,
			        VAR H = [Value]
			        VAR CityCount =
			            COALESCE(
			                CALCULATE(
			                    DISTINCTCOUNT('marts fct_pollution_hourly'[city]),
			                    REMOVEFILTERS('marts fct_pollution_hourly'),
			                    'marts fct_pollution_hourly'[observed_at] >= Cutoff,
			                    'marts fct_pollution_hourly'[hour_utc] = H
			                ),
			                0
			            )
			        VAR X = 2 + H * 20
			        VAR Style =
			            SWITCH(
			                TRUE(),
			                CityCount = 0, "fill='none' stroke='%2330363D' stroke-width='1.5'",
			                CityCount >= TotalCities, "fill='%233FB950'",
			                "fill='%23E67E22'"
			            )
			        RETURN "<rect x='" & FORMAT(X, "0") & "' y='4' width='16' height='20' rx='3' " & Style & "/>",
			        "",
			        [Value], ASC
			    )
			VAR Ticks =
			    "<text x='2' y='41' font-size='10' fill='%238B949E'>00</text>" &
			    "<text x='118' y='41' font-size='10' fill='%238B949E'>06</text>" &
			    "<text x='238' y='41' font-size='10' fill='%238B949E'>12</text>" &
			    "<text x='358' y='41' font-size='10' fill='%238B949E'>18</text>" &
			    "<text x='456' y='41' font-size='10' fill='%238B949E'>24</text>"
			VAR SvgRaw = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 484 46'>" & Boxes & Ticks & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SvgRaw, " ", "%20")
		lineageTag: b6ec424f-8754-4b3f-8e12-5e5ef6d6e2f9
		dataCategory: ImageUrl

	measure 'AQ Coverage Chip' = VAR C = [Coverage % (24h)] VAR H = [Coverage Hours (24h)] VAR L = [Last Reading (UTC)] RETURN UNICHAR ( 9679 ) & " Coverage " & FORMAT ( C, "0%" ) & "  " & UNICHAR ( 183 ) & "  " & FORMAT ( H, "0" ) & "/24h  " & UNICHAR ( 183 ) & "  " & L
		displayFolder: Air Quality Redesign
		lineageTag: 7ffde0d7-5f39-49b0-a2ed-a0e27d171177

	measure 'AQ Coverage Chip Color' = VAR C = [Coverage % (24h)] RETURN SWITCH ( TRUE (), ISBLANK ( C ), "#8B949E", C >= 0.9, "#46D477", C >= 0.5, "#F5C518", "#F17632" )
		isHidden
		displayFolder: Air Quality Redesign
		lineageTag: 4697beb1-4c37-4beb-a87f-da84d73c4ce5

	measure 'AQ Insight' =
			VAR Cat = [Current AQI Category]
			VAR Dom = [Dominant Pollutant]
			VAR P = [Current PM2.5]
			VAR Pred = [Predicted PM2.5 (24h)]
			VAR Cov = [Coverage % (24h)]
			VAR Dir = SWITCH ( TRUE (), ISBLANK ( Pred ) || ISBLANK ( P ), "", Pred > P + 0.5, " The model predicts a slight increase over the next 24 hours.", Pred < P - 0.5, " The model predicts a slight decrease over the next 24 hours.", " The model predicts little change over the next 24 hours." )
			VAR CovNote = IF ( COALESCE ( Cov, 1 ) < 0.9, " Readings cover only " & FORMAT ( Cov, "0%" ) & " of the last 24 hours, so treat these values as indicative.", "" )
			RETURN
			"Air quality is " & Cat & "." & IF ( ISBLANK ( Dom ), "", " " & Dom & " is the dominant pollutant relative to its WHO limit" & IF ( ISBLANK ( P ), ".", ", while PM2.5 sits at " & FORMAT ( P, "0.0" ) & " " & UNICHAR ( 181 ) & "g/m" & UNICHAR ( 179 ) & "." ) ) & Dir & CovNote
		displayFolder: Air Quality Redesign
		lineageTag: b4f2c73e-b63f-4ca1-be84-506b539d37d2

	column _
		lineageTag: af5b0cdc-a746-480d-8af7-2d1fbaa71323
		isNameInferred
		sourceColumn: [_]

	partition _KPIs_AirQuality = calculated
		source = ROW("_", BLANK())

