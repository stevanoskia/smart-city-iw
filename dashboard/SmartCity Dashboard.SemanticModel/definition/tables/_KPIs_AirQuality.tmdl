	measure 'Next Alert Summary' =
			VAR Soonest =
			    TOPN(
			        1,
			        'marts mart_weather_alerts',
			        'marts mart_weather_alerts'[lead_time_hours], ASC
			    )
			VAR TheCity = MAXX(Soonest, 'marts mart_weather_alerts'[city])
			VAR TheType = MAXX(Soonest, 'marts mart_weather_alerts'[alert_type])
			VAR TheHours = MAXX(Soonest, 'marts mart_weather_alerts'[lead_time_hours])
			RETURN
			IF(
			    ISBLANK(TheCity),
			    "No active weather alerts",
			    TheType & " in " & TheCity & " - " &
			    IF(TheHours < 24, FORMAT(TheHours, "0") & "h away", FORMAT(ROUND(TheHours / 24, 0), "0") & "d away")
			)
