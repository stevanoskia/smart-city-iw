	measure 'Congestion AQI Correlation (weekly)' =
			VAR Base =
			    ADDCOLUMNS(
			        FILTER(
			            'marts mart_city_daily',
			            NOT ISBLANK('marts mart_city_daily'[avg_congestion_score])
			                && NOT ISBLANK('marts mart_city_daily'[avg_aqi])
			        ),
			        "@WeekKey", RELATED('marts dim_date'[year]) * 100 + RELATED('marts dim_date'[week_of_year])
			    )
			VAR Agg =
			    GROUPBY(
			        Base,
			        'marts mart_city_daily'[city],
			        [@WeekKey],
			        "@C", AVERAGEX(CURRENTGROUP(), 'marts mart_city_daily'[avg_congestion_score]),
			        "@A", AVERAGEX(CURRENTGROUP(), 'marts mart_city_daily'[avg_aqi])
			    )
			VAR N = COUNTROWS(Agg)
			VAR TotX = SUMX(Agg, [@C])
			VAR TotY = SUMX(Agg, [@A])
			VAR TotXY = SUMX(Agg, [@C] * [@A])
			VAR TotX2 = SUMX(Agg, [@C] ^ 2)
			VAR TotY2 = SUMX(Agg, [@A] ^ 2)
			VAR Num = N * TotXY - TotX * TotY
			VAR Den = SQRT((N * TotX2 - TotX ^ 2) * (N * TotY2 - TotY ^ 2))
			RETURN IF(N >= 10 && Den <> 0, DIVIDE(Num, Den), BLANK())
		formatString: 0.00
		lineageTag: 1d087f4a-3e6e-43e8-a2ec-ef81803310f4

	measure 'Correlation Paired Weeks' =
			VAR Base =
			    ADDCOLUMNS(
			        FILTER(
			            'marts mart_city_daily',
			            NOT ISBLANK('marts mart_city_daily'[avg_congestion_score])
			                && NOT ISBLANK('marts mart_city_daily'[avg_aqi])
			        ),
			        "@WeekKey", RELATED('marts dim_date'[year]) * 100 + RELATED('marts dim_date'[week_of_year])
			    )
			RETURN
			COALESCE(
			    COUNTROWS(GROUPBY(Base, 'marts mart_city_daily'[city], [@WeekKey])),
			    0
			)
		formatString: 0
		lineageTag: 41b491f1-39ad-4494-87ee-50fcc424e19d

	measure 'Congestion AQI Correlation (by city)' =
			VAR Agg =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE('marts mart_city_daily', 'marts mart_city_daily'[city]),
			            "@C", CALCULATE(AVERAGE('marts mart_city_daily'[avg_congestion_score])),
			            "@A", CALCULATE(AVERAGE('marts mart_city_daily'[avg_aqi]))
			        ),
			        NOT ISBLANK([@C]) && NOT ISBLANK([@A])
			    )
			VAR N = COUNTROWS(Agg)
			VAR TotX = SUMX(Agg, [@C])
			VAR TotY = SUMX(Agg, [@A])
			VAR TotXY = SUMX(Agg, [@C] * [@A])
			VAR TotX2 = SUMX(Agg, [@C] ^ 2)
			VAR TotY2 = SUMX(Agg, [@A] ^ 2)
			VAR Num = N * TotXY - TotX * TotY
			VAR Den = SQRT((N * TotX2 - TotX ^ 2) * (N * TotY2 - TotY ^ 2))
			RETURN IF(N >= 5 && Den <> 0, DIVIDE(Num, Den), BLANK())
		formatString: 0.00
		lineageTag: e4cbfffe-3761-4374-9994-4f59947d22e1

