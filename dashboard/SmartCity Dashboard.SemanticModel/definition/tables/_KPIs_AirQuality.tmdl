	measure 'Congestion AQI Correlation' =
			VAR Paired =
			    FILTER(
			        'marts mart_city_daily',
			        NOT ISBLANK('marts mart_city_daily'[avg_congestion_score])
			            && NOT ISBLANK('marts mart_city_daily'[avg_aqi])
			    )
			VAR N = COUNTROWS(Paired)
			VAR TotX = SUMX(Paired, 'marts mart_city_daily'[avg_congestion_score])
			VAR TotY = SUMX(Paired, 'marts mart_city_daily'[avg_aqi])
			VAR TotXY = SUMX(Paired, 'marts mart_city_daily'[avg_congestion_score] * 'marts mart_city_daily'[avg_aqi])
			VAR TotX2 = SUMX(Paired, 'marts mart_city_daily'[avg_congestion_score] ^ 2)
			VAR TotY2 = SUMX(Paired, 'marts mart_city_daily'[avg_aqi] ^ 2)
			VAR Num = N * TotXY - TotX * TotY
			VAR Den = SQRT((N * TotX2 - TotX ^ 2) * (N * TotY2 - TotY ^ 2))
			RETURN IF(N >= 10 && Den <> 0, DIVIDE(Num, Den), BLANK())
		formatString: 0.00
		lineageTag: 23a0f771-90a8-4442-bac1-44f34cc3ea0b

	measure 'Congestion PM2.5 Correlation (daily)' =
			VAR Paired =
			    FILTER(
			        'marts mart_city_daily',
			        NOT ISBLANK('marts mart_city_daily'[avg_congestion_score])
			            && NOT ISBLANK('marts mart_city_daily'[avg_pm2_5_ug_m3])
			    )
			VAR N = COUNTROWS(Paired)
			VAR TotX = SUMX(Paired, 'marts mart_city_daily'[avg_congestion_score])
			VAR TotY = SUMX(Paired, 'marts mart_city_daily'[avg_pm2_5_ug_m3])
			VAR TotXY = SUMX(Paired, 'marts mart_city_daily'[avg_congestion_score] * 'marts mart_city_daily'[avg_pm2_5_ug_m3])
			VAR TotX2 = SUMX(Paired, 'marts mart_city_daily'[avg_congestion_score] ^ 2)
			VAR TotY2 = SUMX(Paired, 'marts mart_city_daily'[avg_pm2_5_ug_m3] ^ 2)
			VAR Num = N * TotXY - TotX * TotY
			VAR Den = SQRT((N * TotX2 - TotX ^ 2) * (N * TotY2 - TotY ^ 2))
			RETURN IF(N >= 10 && Den <> 0, DIVIDE(Num, Den), BLANK())
		formatString: 0.00
		lineageTag: fe313465-c6c6-48a6-9bef-e854add62006

	measure 'Correlation Strength Label' =
			VAR R = [Congestion AQI Correlation (by city)]
			VAR A = ABS(R)
			VAR Strength =
			    SWITCH(
			        TRUE(),
			        ISBLANK(R), "Not enough data",
			        A < 0.2, "Very weak",
			        A < 0.4, "Weak",
			        A < 0.6, "Moderate",
			        A < 0.8, "Strong",
			        "Very strong"
			    )
			VAR Direction = IF(ISBLANK(R), "", IF(R >= 0, " positive", " negative"))
			RETURN Strength & Direction
		lineageTag: 52fe44c2-f5fc-416f-be83-21afa3418069

	measure 'Correlation Insight' =
			VAR R = [Congestion AQI Correlation (by city)]
			VAR Cities = [Traffic Covered Cities]
			VAR Days = [Correlation Paired Days]
			VAR Reading =
			    SWITCH(
			        TRUE(),
			        ABS(R) < 0.2, "City congestion levels show almost no relationship with their AQI.",
			        ABS(R) < 0.4, "More congested cities tend to have only slightly higher AQI - the link is weak.",
			        ABS(R) < 0.6, "More congested cities tend to have moderately higher AQI.",
			        "More congested cities clearly tend to have higher AQI."
			    )
			RETURN
			IF(
			    ISBLANK(R),
			    "Not enough cities with traffic coverage to assess a relationship.",
			    Reading & " Each point is one city averaged over " & Days & " city-days. Only " & Cities &
			    " cities have traffic coverage, so this is a small sample - treat as indicative, not conclusive."
			)
		lineageTag: a137103f-ac8a-44a6-80d9-d1f59739867c

