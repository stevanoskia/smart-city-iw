	measure 'PM2.5 vs Yesterday' =
			VAR Today = CALCULATE(MAX('marts fct_pollution_daily'[date_utc]), ALLSELECTED('marts fct_pollution_daily'))
			VAR TodayVal = CALCULATE(AVERAGE('marts fct_pollution_daily'[avg_pm2_5_ug_m3]), 'marts fct_pollution_daily'[date_utc] = Today)
			VAR YestVal = CALCULATE(AVERAGE('marts fct_pollution_daily'[avg_pm2_5_ug_m3]), 'marts fct_pollution_daily'[date_utc] = Today - 1)
			RETURN TodayVal - YestVal
		formatString: +0.0;-0.0;0.0
		lineageTag: b33a29ba-6030-4ac1-b04c-962e7da0b4bf

