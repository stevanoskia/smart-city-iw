	measure 'Current PM2.5' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR LatestRow = TOPN(1, 'marts fct_pollution_hourly', 'marts fct_pollution_hourly'[observed_at], DESC)
			        RETURN AVERAGEX(LatestRow, 'marts fct_pollution_hourly'[pm2_5_ug_m3])
			    )
			)
		formatString: 0.0
		lineageTag: e752919f-df2e-4921-b3e8-e4dd9347c716

