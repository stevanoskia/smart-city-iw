	measure 'Poor AQI Hours %' = DIVIDE(SUM('marts fct_pollution_daily'[hours_poor_air]), SUM('marts fct_pollution_daily'[observation_count]))
		formatString: 0.0%
		lineageTag: f6c6f049-ca8e-47e5-a723-03879df578c4

	measure 'AQI Health Recommendation' =
			VAR AQI = ROUND([Avg AQI (Latest)], 0)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(AQI), "Air-quality data unavailable.",
			    AQI <= 1, "Air quality is good. Normal outdoor activity is suitable.",
			    AQI = 2, "Air quality is fair. Sensitive individuals should consider limiting prolonged exertion outdoors.",
			    AQI = 3, "Air quality is moderate. Sensitive groups should reduce prolonged outdoor activity.",
			    AQI = 4, "Air quality is poor. Reduce prolonged outdoor activity, especially for sensitive groups.",
			    "Air quality is very poor. Avoid strenuous outdoor activity where possible."
			)
		lineageTag: 1738bc82-8613-4820-a079-b207f54830cd

	measure 'Congestion PM2.5 Paired Days' =
			VAR Paired =
			    ADDCOLUMNS(
			        'marts fct_pollution_daily',
			        "CongestionVal", LOOKUPVALUE('marts fct_traffic_daily'[avg_congestion_score], 'marts fct_traffic_daily'[city_date_key], 'marts fct_pollution_daily'[city_date_key])
			    )
			RETURN COUNTROWS(FILTER(Paired, NOT ISBLANK([CongestionVal])))
		formatString: 0
		lineageTag: 40f38aa5-0b20-4f15-a37f-0eee2ead4dcc

	measure 'Congestion PM2.5 Correlation' =
			VAR Paired =
			    ADDCOLUMNS(
			        'marts fct_pollution_daily',
			        "CongestionVal", LOOKUPVALUE('marts fct_traffic_daily'[avg_congestion_score], 'marts fct_traffic_daily'[city_date_key], 'marts fct_pollution_daily'[city_date_key])
			    )
			VAR ValidPairs = FILTER(Paired, NOT ISBLANK([CongestionVal]))
			VAR N = COUNTROWS(ValidPairs)
			VAR TotalX = SUMX(ValidPairs, 'marts fct_pollution_daily'[avg_pm2_5_ug_m3])
			VAR TotalY = SUMX(ValidPairs, [CongestionVal])
			VAR TotalXY = SUMX(ValidPairs, 'marts fct_pollution_daily'[avg_pm2_5_ug_m3] * [CongestionVal])
			VAR TotalX2 = SUMX(ValidPairs, 'marts fct_pollution_daily'[avg_pm2_5_ug_m3] ^ 2)
			VAR TotalY2 = SUMX(ValidPairs, [CongestionVal] ^ 2)
			VAR Numerator = N * TotalXY - TotalX * TotalY
			VAR Denominator = SQRT((N * TotalX2 - TotalX ^ 2) * (N * TotalY2 - TotalY ^ 2))
			RETURN IF(N >= 10 && Denominator <> 0, DIVIDE(Numerator, Denominator), BLANK())
		formatString: 0.00
		lineageTag: dc996a55-279b-4e7e-a5ae-c60f6d75612e

	measure 'Traffic Coverage %' =
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT('marts fct_traffic_daily'[city]), ALLSELECTED('marts fct_traffic_daily')),
			    CALCULATE(DISTINCTCOUNT('marts dim_city'[city]), ALLSELECTED('marts dim_city'))
			)
		formatString: 0%
		lineageTag: 58935a0f-bdd6-41a0-b0b9-caea7b7ce12b

	measure 'Current AQI' = [Avg AQI (Latest)]
		formatString: 0
		lineageTag: c31c5ff1-68c5-4554-90c4-1e6d9c260a42

	measure 'Current AQI Category' =
			VAR AQI = ROUND([Current AQI], 0)
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(AQI), "N/A",
			    AQI <= 1, "Good",
			    AQI = 2, "Fair",
			    AQI = 3, "Moderate",
			    AQI = 4, "Poor",
			    "Very Poor"
			)
		lineageTag: e168784c-91d4-431e-a000-008b6f4356b5

	measure 'Current AQI Category Color' =
			SWITCH(
			    TRUE(),
			    [Current AQI Category] = "Good", "#2ECC71",
			    [Current AQI Category] = "Fair", "#A9D751",
			    [Current AQI Category] = "Moderate", "#F1C40F",
			    [Current AQI Category] = "Poor", "#E67E22",
			    [Current AQI Category] = "Very Poor", "#E74C3C",
			    "#95A5A6"
			)
		lineageTag: e4d23de8-a9b7-4033-af47-ef2ff7be90f3

	measure 'Current AQI (Gauge Value)' = DIVIDE([Current AQI] - 1, 5 - 1) * 100
