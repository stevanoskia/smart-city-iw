table _KPIs_Weather
	lineageTag: 19512141-4f8e-4593-a708-b6b4a2ecd612

	measure 'Temp 7D Avg' = AVERAGE('marts mart_temperature_trends'[temp_7d_avg])
		lineageTag: 51a63a6a-645d-4aab-bbaf-f55760f64ada

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Temp 30D Avg' = AVERAGE('marts mart_temperature_trends'[temp_30d_avg])
		lineageTag: 4928b48d-daec-40d3-b0a4-716f4e271a82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Temp Anomaly' =
			
			AVERAGE('marts mart_temperature_trends'[temp_anomaly])
		lineageTag: eee2d976-556f-4643-b0a2-5c4eb5214cd5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hot Anomaly Days' = CALCULATE(COUNTROWS('marts mart_temperature_trends'), 'marts mart_temperature_trends'[temp_anomaly_label] = "Hot anomaly")
		formatString: 0
		lineageTag: 3946f73b-66a9-4106-8aa8-aab370d76342

	measure 'Cold Anomaly Days' = CALCULATE(COUNTROWS('marts mart_temperature_trends'), 'marts mart_temperature_trends'[temp_anomaly_label] = "Cold anomaly")
		formatString: 0
		lineageTag: 59db8f6a-0a47-4d06-8261-74d8c6340ced

	measure 'Hottest City' =
			
			VAR MaxTemp = CALCULATE(MAX('marts mart_city_current'[temp_celsius]), ALLSELECTED('marts mart_city_current'))
			RETURN CALCULATE(SELECTEDVALUE('marts mart_city_current'[city]), 'marts mart_city_current'[temp_celsius] = MaxTemp)
		lineageTag: f98114e8-9d27-4e0f-aecf-57e749287875

	measure 'Coldest City' =
			
			VAR MinTemp = CALCULATE(MIN('marts mart_city_current'[temp_celsius]), ALLSELECTED('marts mart_city_current'))
			RETURN CALCULATE(SELECTEDVALUE('marts mart_city_current'[city]), 'marts mart_city_current'[temp_celsius] = MinTemp)
		lineageTag: 1bf79a69-9175-4b9e-b21a-ffb4c44b5abf

	measure 'Temperature Range' =
			
			VAR MinT = CALCULATE(MIN('marts mart_city_current'[temp_celsius]), ALLSELECTED('marts mart_city_current'))
			VAR MaxT = CALCULATE(MAX('marts mart_city_current'[temp_celsius]), ALLSELECTED('marts mart_city_current'))
			RETURN FORMAT(MinT, "0.0") & "°C – " & FORMAT(MaxT, "0.0") & "°C"
		lineageTag: 00ffb41f-10f1-4888-b994-dfbbbe336ba8

	measure 'Feels Like Difference' =
			
			VAR Diff = AVERAGEX('marts mart_city_current', 'marts mart_city_current'[feels_like_celsius] - 'marts mart_city_current'[temp_celsius])
			RETURN FORMAT(Diff, "+0.0;-0.0") & "°C"
		lineageTag: cd6b10bb-efbf-422a-8e57-63135e46356e

	measure 'Temperature Alerts' =
			
			CALCULATE(
			    COUNTROWS('marts mart_weather_alerts'),
			    'marts mart_weather_alerts'[alert_type] IN {"Extreme heat", "Extreme cold"}
			)
		formatString: 0
		lineageTag: ade14ae6-3ae8-4280-9517-3cc8a67d6591

	measure 'Avg Cloud Cover' =
			
			AVERAGE('marts mart_city_current'[cloudiness_pct]) / 100
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 13a88796-eb92-4de7-a2b1-da5141af5b02

	measure 'Avg Visibility (km)' =
			
			AVERAGE('marts mart_city_current'[visibility_m]) / 1000
		lineageTag: 23f0ca1e-7489-4e2d-8005-58ade6367d2e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Temp Anomaly Display' =
			
			VAR Anomaly = [Avg Temp Anomaly]
			RETURN
			SWITCH(
			    TRUE(),
			    Anomaly > 0, "▲ +" & FORMAT(Anomaly, "0.0") & "°C",
			    Anomaly < 0, "▼ " & FORMAT(Anomaly, "0.0") & "°C",
			    "● 0.0°C"
			)
		lineageTag: bd7ed1e8-3442-45dd-a97e-2d3efa2ca98e

	measure 'Hourly Temp' = AVERAGE('marts fct_weather_hourly'[temp_celsius])
		lineageTag: f65e0dc0-2296-4b2d-9a5f-37d928cf764f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Temp Arrow' =
			
			VAR CurrTemp = AVERAGE('marts fct_weather_hourly'[temp_celsius])
			VAR Avg7D = AVERAGE('marts mart_temperature_trends'[temp_7d_avg])
			RETURN IF(CurrTemp >= Avg7D, "⮝", "⮟")
		lineageTag: 42dfd6bc-2c9c-4bef-977a-260baa523c0e

	measure 'Avg Temp Color' =
			
			VAR CurrTemp = AVERAGE('marts fct_weather_hourly'[temp_celsius])
			VAR Avg7D = AVERAGE('marts mart_temperature_trends'[temp_7d_avg])
			RETURN IF(CurrTemp >= Avg7D, 1, -1)
		formatString: 0
		lineageTag: e779e49b-2ede-4aa7-8674-96635220e6e6

	measure 'Avg Temp Previous Period' =
			
			VAR LatestDate = CALCULATE(MAX('marts dim_date'[date_utc]), ALL('marts dim_date'))
			RETURN
			CALCULATE(
			    [Avg Temp],
			    DATESINPERIOD('marts dim_date'[date_utc], LatestDate - 7, -7, DAY)
			)
		lineageTag: cc4de8b5-09e0-4615-8db9-d807841e5941

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Temp Change %' =
			
			DIVIDE(
			    [Avg Temp] - [Avg Temp Previous Period],
			    [Avg Temp Previous Period]
			)
		lineageTag: b95398e4-a135-4584-a54d-6ca809c8d8fa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Temp Latest Day' =
			
			VAR LatestDate = CALCULATE(MAX('marts dim_date'[date_utc]), ALL('marts dim_date'))
			RETURN
			CALCULATE(
			    [Avg Temp],
			    DATESINPERIOD('marts dim_date'[date_utc], LatestDate, -7, DAY)
			)
		lineageTag: 61226491-9b38-4d6a-b637-e43b69b19753

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Comfort Icon URL' =
			
			VAR ci = [Comfort Index]
			RETURN
			SWITCH(
			    TRUE(),
			    ci < 0.4, "data:image/png;base64,",
			    ci < 0.7, "data:image/png;base64,",
			    "data:image/png;base64,"
			)
		lineageTag: e07a0fdd-f289-4428-85f5-00b7ba9e0363

	measure 'Forecast Daily High' = CALCULATE(MAX('marts mart_forecast_latest'[temp_celsius]))
		lineageTag: 0ee28312-131d-4f58-8874-454806572c2d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Daily Low' = CALCULATE(MIN('marts mart_forecast_latest'[temp_celsius]))
		lineageTag: 9f68b25f-0239-4114-b184-7ea2b339d0ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Weather condition at midday (hour=12) for the nearest upcoming forecast date - previously ambiguous because hour=12 recurs across multiple forecast dates, causing SELECTEDVALUE to return blank.
	measure 'Forecast Daily Condition' =
			VAR NearestDate = CALCULATE(MIN('marts mart_forecast_latest'[forecast_date_utc]), 'marts mart_forecast_latest'[forecast_hour_utc] = 12)
			RETURN
			CALCULATE(
			    SELECTEDVALUE('marts mart_forecast_latest'[weather_main]),
			    'marts mart_forecast_latest'[forecast_hour_utc] = 12,
			    'marts mart_forecast_latest'[forecast_date_utc] = NearestDate
			)
		lineageTag: 3c480d71-8170-4e94-9fd3-78973fc5025a

	measure 'Forecast Icon URL' =
			
			VAR cond = [Forecast Daily Condition]
			VAR code =
			    SWITCH(
			        TRUE(),
			        cond = "Clear", "01d",
			        cond = "Clouds", "03d",
			        cond = "Rain", "10d",
			        cond = "Drizzle", "09d",
			        cond = "Thunderstorm", "11d",
			        cond = "Snow", "13d",
			        cond = "Mist" || cond = "Fog" || cond = "Haze", "50d",
			        "01d"
			    )
			RETURN
			"https://openweathermap.org/img/wn/" & code & "@2x.png"
		lineageTag: 237b821a-fc4c-40c3-9286-891e46427bbe
		dataCategory: ImageUrl

	measure 'Forecast Day Name' = FORMAT(MAX('marts mart_forecast_latest'[forecast_date_utc]), "ddd")
		lineageTag: 615e231a-53d7-4585-9be3-bce75303327c

	/// High/Medium/Low based on Avg Visibility (km): <2km High, <5km Medium, else Low.
	measure 'Weather Impact (Visibility)' =
			VAR Vis = [Avg Visibility (km)]
			RETURN
			IF(
			    ISBLANK(Vis),
			    BLANK(),
			    SWITCH(
			        TRUE(),
			        Vis < 2, "High",
			        Vis < 5, "Medium",
			        "Low"
			    )
			)
		lineageTag: a549b916-436a-4fec-a006-7bbd30afef3c

	/// High/Medium/Low based on Forecast Daily Condition (weather_main text).
	measure 'Weather Impact (Condition)' =
			VAR Cond = [Forecast Daily Condition]
			RETURN
			IF(
			    ISBLANK(Cond),
			    BLANK(),
			    SWITCH(
			        Cond,
			        "Thunderstorm", "High",
			        "Rain", "Medium",
			        "Snow", "High",
			        "Fog", "Medium",
			        "Low"
			    )
			)
		lineageTag: 68d1ec11-4142-4069-8079-ee7f18af9cb8

	measure 'Temp vs Yesterday %' =
			VAR Today = CALCULATE(MAX('marts fct_weather_daily'[date_utc]), ALLSELECTED('marts fct_weather_daily'))
			VAR TodayVal = CALCULATE(AVERAGE('marts fct_weather_daily'[avg_temp_celsius]), 'marts fct_weather_daily'[date_utc] = Today)
			VAR YestVal = CALCULATE(AVERAGE('marts fct_weather_daily'[avg_temp_celsius]), 'marts fct_weather_daily'[date_utc] = Today - 1)
			RETURN DIVIDE(TodayVal - YestVal, YestVal)
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: b3af8a7b-a2ee-4074-ad56-45e02552eec8

	measure 'Temp Trend Arrow' = IF([Temp vs Yesterday %] >= 0, UNICHAR(11165), UNICHAR(11167))
		lineageTag: 32a2fdc3-ad6c-4b5a-9dc9-ae9c950fcecc

	measure 'Temp Trend Color' = IF([Temp vs Yesterday %] <= 0, "#5DADE2", "#E67E22")
		lineageTag: 678072d9-3ede-4bb7-9899-d5bc644ba4a5

	measure 'Temp Sparkline' =
			VAR LatestDate = CALCULATE(MAX('marts fct_weather_daily'[date_utc]), ALLSELECTED('marts fct_weather_daily'))
			VAR StartDate = LatestDate - 13
			VAR TrendTable =
			    ADDCOLUMNS(
			        FILTER(
			            ALL('marts fct_weather_daily'[date_utc]),
			            'marts fct_weather_daily'[date_utc] >= StartDate && 'marts fct_weather_daily'[date_utc] <= LatestDate
			        ),
			        "@Val", CALCULATE(AVERAGE('marts fct_weather_daily'[avg_temp_celsius]))
			    )
			VAR CleanTrend = FILTER(TrendTable, NOT ISBLANK([@Val]))
			VAR PointCount = COUNTROWS(CleanTrend)
			VAR RankedTrend =
			    ADDCOLUMNS(
			        CleanTrend,
			        "@Idx", RANKX(CleanTrend, 'marts fct_weather_daily'[date_utc],, ASC, Dense) - 1
			    )
			VAR MinY = MINX(RankedTrend, [@Val])
			VAR MaxY = MAXX(RankedTrend, [@Val])
			VAR YRange = IF(MaxY = MinY, 1, MaxY - MinY)
			VAR W = 120
			VAR H = 30
			VAR Pad = 2
			VAR PlotW = W - 2 * Pad
			VAR PlotH = H - 2 * Pad
			VAR PointsStr =
			    CONCATENATEX(
			        RankedTrend,
			        VAR X = Pad + DIVIDE([@Idx], PointCount - 1) * PlotW
			        VAR YNorm = DIVIDE([@Val] - MinY, YRange)
			        VAR Y = Pad + (1 - YNorm) * PlotH
			        RETURN FORMAT(ROUND(X, 2), "General Number", "en-US") & "," & FORMAT(ROUND(Y, 2), "General Number", "en-US")
			        , " ",
			        [@Idx], ASC
			    )
			VAR PrevVal = MAXX(FILTER(RankedTrend, [@Idx] = PointCount - 2), [@Val])
			VAR LastVal = MAXX(FILTER(RankedTrend, [@Idx] = PointCount - 1), [@Val])
			VAR StrokeColor = IF(LastVal <= PrevVal, "%235DADE2", "%23E67E22")
			VAR AreaPoints = Pad & "," & (H - Pad) & " " & PointsStr & " " & (W - Pad) & "," & (H - Pad)
			VAR SvgRaw =
			    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 " & W & " " & H & "'><defs><linearGradient id='g' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='" & StrokeColor & "' stop-opacity='0.45'/><stop offset='1' stop-color='" & StrokeColor & "' stop-opacity='0'/></linearGradient></defs><polygon points='" & AreaPoints & "' fill='url(%23g)' stroke='none'/><polyline fill='none' stroke='" & StrokeColor & "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' points='" & PointsStr & "'/></svg>"
			RETURN
			IF(PointCount < 2, BLANK(), "data:image/svg+xml;utf8," & SUBSTITUTE(SvgRaw, " ", "%20"))
		lineageTag: 861a0dc9-0b8b-4f79-97b5-82aa816929e1
		dataCategory: ImageUrl

	measure 'Forecast Condition Count' = COUNTROWS ( 'marts mart_forecast_latest' )
		formatString: 0
		displayFolder: Weather Overview
		lineageTag: ad8c0c7a-b420-48d0-a6de-a42faaa24bf3

	measure 'W4 Wind (km/h)' = [Wind Speed (m/s)] * 3.6
		formatString: 0" km/h"
		displayFolder: Weather Intelligence
		lineageTag: 31787362-8283-4a02-b57a-2b5d3d9cb386

	measure 'High (°C)' = CALCULATE ( MAX ( 'marts mart_city_daily'[max_temp_celsius] ), REMOVEFILTERS ( 'marts dim_date' ) )
		formatString: 0
		displayFolder: Weather Intelligence
		lineageTag: 88ab1f62-e939-421b-9934-089afa408741

	measure 'Avg (°C)' = CALCULATE ( AVERAGE ( 'marts mart_city_daily'[avg_temp_celsius] ), REMOVEFILTERS ( 'marts dim_date' ) )
		formatString: 0
		displayFolder: Weather Intelligence
		lineageTag: a8d59b15-2472-4bd3-a369-779387797133

	measure 'Low (°C)' = CALCULATE ( MIN ( 'marts mart_city_daily'[min_temp_celsius] ), REMOVEFILTERS ( 'marts dim_date' ) )
		formatString: 0
		displayFolder: Weather Intelligence
		lineageTag: 7700df46-bab0-4684-98e5-f75d89ead9fe

	measure 'W4 Daylight' = VAR A = SELECTEDVALUE ( 'marts mart_city_current'[sunrise_at] ) VAR B = SELECTEDVALUE ( 'marts mart_city_current'[sunset_at] ) RETURN IF ( ISBLANK ( A ) || ISBLANK ( B ), UNICHAR ( 8212 ), INT ( ( B - A ) * 24 ) & "h " & FORMAT ( MOD ( INT ( ( B - A ) * 1440 ), 60 ), "00" ) & "m" )
		displayFolder: Weather Intelligence
		lineageTag: a72c6c8c-b981-4b7e-ac92-f775c358f6f2

	measure 'W4 Wind Risk' = VAR W = [W4 Wind (km/h)] RETURN SWITCH ( TRUE (), ISBLANK ( W ), "N/A", W >= 60, "High", W >= 35, "Moderate", "Low" )
		displayFolder: Weather Intelligence
		lineageTag: a3129e16-d8ba-4a31-bbcc-c3226af9827c

	measure 'W4 Wind Risk Color' = SWITCH ( [W4 Wind Risk], "High", "#F04F45", "Moderate", "#F5C518", "Low", "#46D477", "#8B949E" )
		isHidden
		displayFolder: Weather Intelligence
		lineageTag: 73a8b00c-e5be-4642-aae6-1d339bca8770

	measure 'W4 Precipitation Risk' = VAR R = [Rain Probability] RETURN IF ( ISBLANK ( R ), UNICHAR ( 8212 ), FORMAT ( R, "0" ) & "%" )
		displayFolder: Weather Intelligence
		lineageTag: b6b291fd-d881-4ba5-9eb3-c3e193987920

	measure 'W4 Precipitation Risk Color' = VAR R = [Rain Probability] RETURN SWITCH ( TRUE (), ISBLANK ( R ), "#8B949E", R >= 60, "#F04F45", R >= 25, "#F5C518", "#46D477" )
		isHidden
		displayFolder: Weather Intelligence
		lineageTag: a5a79172-458c-4d32-9482-494baaa3f0c9

	measure 'W4 Visibility Display' = VAR V = [Avg Visibility (km)] RETURN IF ( ISBLANK ( V ), UNICHAR ( 8212 ), FORMAT ( V, "0.0" ) & " km" )
		displayFolder: Weather Intelligence
		lineageTag: 242c8be2-9fb8-4bce-83ce-5860c9c15c1a

	measure 'W4 Impact Color' = SWITCH ( [Weather Impact (Condition)], "High", "#F04F45", "Medium", "#F5C518", "Low", "#46D477", "#8B949E" )
		isHidden
		displayFolder: Weather Intelligence
		lineageTag: 92f84ce5-e04f-46c7-9f18-6dfdda8c5457

	measure 'W4 Insight' =
			VAR C = SELECTEDVALUE ( 'marts dim_city'[city] )
			VAR T = [Current Temp (°C)]
			VAR NetAvg = CALCULATE ( [Current Temp (°C)], REMOVEFILTERS ( 'marts dim_city' ) )
			VAR Cond = LOWER ( [Weather Condition] )
			VAR R = [Rain Probability]
			VAR Vis = [Avg Visibility (km)]
			VAR Imp = [Weather Impact (Condition)]
			RETURN
			IF (
			    NOT HASONEVALUE ( 'marts dim_city'[city] ),
			    "Across all monitored cities the average temperature is " & FORMAT ( NetAvg, "0.0" ) & "°C. Select a city for a detailed weather assessment.",
			    C & " is " & IF ( T >= NetAvg, "warmer", "cooler" ) & " than the monitored-city average of " & FORMAT ( NetAvg, "0.0" ) & "°C, with " & Cond & ". "
			        & IF ( COALESCE ( R, 0 ) < 25, "Conditions remain dry with low rain probability", "Rain is likely at " & FORMAT ( R, "0" ) & "% probability" )
			        & IF ( ISBLANK ( Vis ), "", " and visibility of " & FORMAT ( Vis, "0.0" ) & " km" ) & ". "
			        & SWITCH ( Imp, "Low", "No major weather-related mobility disruption is expected.", "Medium", "Some weather-related mobility disruption is possible.", "High", "Significant weather-related mobility disruption is expected.", "" )
			)
		displayFolder: Weather Intelligence
		lineageTag: 7702960d-de09-486f-9f0d-6ead847a5e5f

	measure 'Forecast Temp 24h' = AVERAGE ( 'marts mart_forecast_latest'[temp_celsius] )
		formatString: 0.0"°C"
		displayFolder: Weather Intelligence
		lineageTag: 5007842f-9d13-4541-b8fb-1e5212df9e82

