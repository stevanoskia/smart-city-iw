	measure 'Temperature Model Status' =
			VAR M = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "temperature_3h")
			VAR B = CALCULATE(SUM('ml_predictions model_metrics'[baseline_mae]), 'ml_predictions model_metrics'[model_name] = "temperature_3h")
			RETURN IF(M < B, "Beats baseline", "Experimental - does not beat baseline")
		lineageTag: cfb91e4a-18fa-4f70-ac7d-6f728a2e7dfb

	measure 'Traffic Model MAE' = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "traffic_congestion_1h")
		formatString: 0.000
