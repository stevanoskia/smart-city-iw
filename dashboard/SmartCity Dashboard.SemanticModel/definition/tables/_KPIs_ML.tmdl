table _KPIs_ML
	isHidden
	lineageTag: e6fc1bad-08dd-45e6-846d-b8abbc56c996

	measure 'Predicted PM2.5 (24h)' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR LatestRow = TOPN(1, 'ml_predictions aqi_forecast', 'ml_predictions aqi_forecast'[predicted_for], DESC)
			        RETURN AVERAGEX(LatestRow, 'ml_predictions aqi_forecast'[predicted_pm2_5])
			    )
			)
		formatString: 0.0
		lineageTag: 721958f3-6b36-49d0-b2a0-5acb8c64f0d9

	measure 'Predicted Temp (3h)' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR LatestRow = TOPN(1, 'ml_predictions temperature_forecast', 'ml_predictions temperature_forecast'[predicted_for], DESC)
			        RETURN AVERAGEX(LatestRow, 'ml_predictions temperature_forecast'[predicted_temp])
			    )
			)
		formatString: 0.0
		lineageTag: 160f004c-e7ba-45cc-b0fb-d14fb2812be0

	measure 'Predicted Congestion (1h)' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR LatestRow = TOPN(1, 'ml_predictions traffic_forecast', 'ml_predictions traffic_forecast'[predicted_for], DESC)
			        RETURN AVERAGEX(LatestRow, 'ml_predictions traffic_forecast'[predicted_congestion])
			    )
			) * 100
		formatString: 0.0
		lineageTag: d31f45e5-9f13-4981-a185-fee9cf23b772

	measure 'Predicted Comfort (1d)' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR LatestRow = TOPN(1, 'ml_predictions city_score_forecast', 'ml_predictions city_score_forecast'[predicted_for], DESC)
			        RETURN AVERAGEX(LatestRow, 'ml_predictions city_score_forecast'[predicted_comfort_index])
			    )
			)
		formatString: 0.00
		lineageTag: 5ee844bd-226f-45c9-a771-ece6bf364e98

	measure 'Active Anomalies' =
			COALESCE(
			    SUMX(
			        VALUES('marts dim_city'[city]),
			        CALCULATE(
			            VAR LatestRow = TOPN(1, 'ml_predictions pollution_anomaly', 'ml_predictions pollution_anomaly'[observed_at], DESC)
			            RETURN COUNTROWS(FILTER(LatestRow, 'ml_predictions pollution_anomaly'[is_anomaly]))
			        )
			    ),
			    0
			)
		formatString: 0
		lineageTag: 0d20467d-11ab-4cc9-be4e-440673477030

	measure 'Anomaly Status' = IF([Active Anomalies] > 0, "âš  Anomaly detected", "âœ… Normal")
		lineageTag: df25053a-145f-4fb3-857a-addc48aa0d60

	measure 'AQI Model MAE' = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
		formatString: 0.000
		lineageTag: dc526cba-08b0-41e4-850a-fe810ea4af49

	measure 'AQI Model RMSE' = CALCULATE(SUM('ml_predictions model_metrics'[rmse]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
		formatString: 0.000
		lineageTag: c87d8980-7322-4895-ba6d-ec073321cf7e

	measure 'AQI Model MAPE' = CALCULATE(SUM('ml_predictions model_metrics'[mape]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
		formatString: 0.0"%"
		lineageTag: 8fcccb9e-cd99-4a04-a99a-ff5e696e2593

	measure 'AQI Model R2' = CALCULATE(SUM('ml_predictions model_metrics'[r2]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
		formatString: 0.00
		lineageTag: 6dc03952-126c-4150-a5b8-a6db2ad0bfd6

	measure 'AQI Model Status' =
			VAR M = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
			VAR B = CALCULATE(SUM('ml_predictions model_metrics'[baseline_mae]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
			RETURN IF(M < B, "Beats baseline", "Experimental - does not beat baseline")
		lineageTag: 55040f61-3dc5-4e52-beac-fc5adc7201f4

	measure 'Temperature Model MAE' = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "temperature_3h")
		formatString: 0.000
