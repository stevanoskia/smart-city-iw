	measure 'Temperature Model MAPE' = CALCULATE(SUM('ml_predictions model_metrics'[mape]), 'ml_predictions model_metrics'[model_name] = "temperature_3h")
		formatString: 0.0"%"
		lineageTag: a3e5ed44-88e6-4835-92c1-646a52b08fdf

	measure 'Temperature Model R2' = CALCULATE(SUM('ml_predictions model_metrics'[r2]), 'ml_predictions model_metrics'[model_name] = "temperature_3h")
		formatString: 0.00
