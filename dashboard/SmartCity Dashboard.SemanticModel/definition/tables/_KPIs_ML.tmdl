	measure 'Traffic Model Status' =
			VAR M = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "traffic_congestion_1h")
			VAR B = CALCULATE(SUM('ml_predictions model_metrics'[baseline_mae]), 'ml_predictions model_metrics'[model_name] = "traffic_congestion_1h")
			RETURN IF(M < B, "Beats baseline", "Experimental - does not beat baseline")
		lineageTag: 2a2be083-ee8b-4d43-8b1f-833f466fcdc9

	measure 'City Score Model MAE' = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "city_score_comfort_1d")
		formatString: 0.000
		lineageTag: 69720576-c803-4a8b-9e32-e335fff95e5e

	measure 'City Score Model RMSE' = CALCULATE(SUM('ml_predictions model_metrics'[rmse]), 'ml_predictions model_metrics'[model_name] = "city_score_comfort_1d")
		formatString: 0.000
		lineageTag: 9ef3c25b-d538-4a37-8e40-5c19b7d9d506

	measure 'City Score Model MAPE' = CALCULATE(SUM('ml_predictions model_metrics'[mape]), 'ml_predictions model_metrics'[model_name] = "city_score_comfort_1d")
		formatString: 0.0"%"
		lineageTag: 13c64ff9-f245-43a2-bd4e-d0ec8d24936e

	measure 'City Score Model R2' = CALCULATE(SUM('ml_predictions model_metrics'[r2]), 'ml_predictions model_metrics'[model_name] = "city_score_comfort_1d")
		formatString: 0.00
		lineageTag: 0abdb899-37a7-42dd-84c9-e06277e83132

	measure 'City Score Model Status' =
			VAR M = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "city_score_comfort_1d")
			VAR B = CALCULATE(SUM('ml_predictions model_metrics'[baseline_mae]), 'ml_predictions model_metrics'[model_name] = "city_score_comfort_1d")
			RETURN IF(M < B, "Beats baseline", "Experimental - does not beat baseline")
		lineageTag: 7b81d044-c957-4bbf-97d4-420ac1089936

	measure 'Predicted PM2.5 Category' =
			VAR V = [Predicted PM2.5 (24h)]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(V), "No forecast",
			    V < 7.5,  "Good",
			    V < 15,   "Fair",
			    V < 22.5, "Moderate",
			    V < 37.5, "Poor",
			    "Very Poor"
			)
		lineageTag: bfd714e3-655d-47e4-8b57-34397aaaac6d

	measure 'Predicted PM2.5 Category Color' =
			SWITCH(
			    [Predicted PM2.5 Category],
			    "Good", "#2ECC71",
			    "Fair", "#A9D751",
			    "Moderate", "#F1C40F",
			    "Poor", "#E67E22",
			    "Very Poor", "#E74C3C",
			    "#95A5A6"
			)
		lineageTag: c45898a7-fd47-4151-a515-cd5f6d89031a

	measure 'AQI Model vs Baseline %' =
			VAR M = CALCULATE(SUM('ml_predictions model_metrics'[mae]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
			VAR B = CALCULATE(SUM('ml_predictions model_metrics'[baseline_mae]), 'ml_predictions model_metrics'[model_name] = "aqi_pm25_24h")
			RETURN IF(B > 0, DIVIDE(B - M, B), BLANK())
		formatString: 0%
		lineageTag: 018641fd-6422-453e-859a-723f43a4b0c6

	measure 'AQI Model Quality Label' =
			VAR Imp = [AQI Model vs Baseline %]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Imp), "Not evaluated",
			    Imp <= 0, "No better than baseline",
			    Imp < 0.15, "Marginally better than baseline",
			    Imp < 0.35, "Better than baseline",
			    "Clearly better than baseline"
			)
		lineageTag: 957952db-7017-4c5f-b740-9ab570d26ee3

	measure 'Live Forecast MAE (7d)' =
			CALCULATE(
			    AVERAGE('_ML_Forecast_Scored'[abs_error]),
			    '_ML_Forecast_Scored'[predicted_for] >= NOW() - 7
			)
		formatString: 0.00
		lineageTag: 7cee2e00-76c5-4226-95c4-a44edbe70b5e

	measure 'Live Forecast RMSE (7d)' =
			SQRT(
			    CALCULATE(
			        AVERAGE('_ML_Forecast_Scored'[squared_error]),
			        '_ML_Forecast_Scored'[predicted_for] >= NOW() - 7
			    )
			)
		formatString: 0.00
		lineageTag: af1411ee-6731-4726-8ee4-2c59f5bb1beb

	measure 'Live Forecast Bias (7d)' =
			CALCULATE(
			    AVERAGE('_ML_Forecast_Scored'[bias]),
			    '_ML_Forecast_Scored'[predicted_for] >= NOW() - 7
			)
		formatString: +0.00;-0.00;0.00
		lineageTag: d2903ec5-95ca-4177-9ab6-fc00630ca8d5

	measure 'Live Forecast Scored (7d)' =
			COALESCE(
			    CALCULATE(
			        COUNTROWS('_ML_Forecast_Scored'),
			        '_ML_Forecast_Scored'[predicted_for] >= NOW() - 7
			    ),
			    0
			)
		formatString: 0
		lineageTag: dd1e18f2-ad94-45ad-9df3-4571a78e1364

	measure 'Live Forecast MAPE (7d)' =
			VAR Rows7d =
			    FILTER(
			        '_ML_Forecast_Scored',
			        '_ML_Forecast_Scored'[predicted_for] >= NOW() - 7
			            && '_ML_Forecast_Scored'[actual_pm2_5] >= 1
			    )
			RETURN AVERAGEX(Rows7d, DIVIDE('_ML_Forecast_Scored'[abs_error], '_ML_Forecast_Scored'[actual_pm2_5]))
		formatString: 0.0%
		lineageTag: a535b79d-f13f-4db9-a4c7-e635a1c1680f

	measure 'Live vs Training MAE' =
			VAR LiveMAE = [Live Forecast MAE (7d)]
			VAR TrainMAE = [AQI Model MAE]
			RETURN IF(TrainMAE > 0 && NOT ISBLANK(LiveMAE), DIVIDE(LiveMAE, TrainMAE), BLANK())
		formatString: 0.0x
		lineageTag: c9a44109-ac34-42e4-9c56-76388cd22cd9

	measure 'Live Forecast Note' =
			VAR N = [Live Forecast Scored (7d)]
			VAR LiveMAE = [Live Forecast MAE (7d)]
			VAR TrainMAE = [AQI Model MAE]
			RETURN
			IF(
			    N = 0,
			    "No matured predictions in the last 7 days yet.",
			    "Measured on " & N & " predictions whose target hour has passed. " &
			    IF(
			        LiveMAE > TrainMAE * 1.5,
			        "Production error is notably higher than the held-out test estimate - expected, and worth monitoring.",
			        "Production error is broadly in line with the held-out test estimate."
			    )
			)
		lineageTag: 200db30e-39e7-4104-b1e4-68668039b27c

	/// Short display aliases. A card visual takes its label straight from the
	/// measure name, and the full names do not fit a ~200px tile - these exist
	/// only so the model-performance tiles read "MAE (7d)" rather than
	/// "Live Forecast MAE (7d)". They add no logic of their own.
	measure 'MAE (7d)' = [Live Forecast MAE (7d)]
		formatString: 0.00
		lineageTag: 5d2a7625-1ce1-4a66-941e-eecf5f18bc30

	measure 'RMSE (7d)' = [Live Forecast RMSE (7d)]
		formatString: 0.00
		lineageTag: 4e06e5da-7f1d-410d-a7f0-2bdf7a5b7883

	measure 'MAPE (7d)' = [Live Forecast MAPE (7d)]
		formatString: 0.0%
		lineageTag: c650859d-a98d-4c70-b47a-c36761f3e838

	measure 'Bias (7d)' = [Live Forecast Bias (7d)]
		formatString: +0.00;-0.00;0.00
		lineageTag: 39c518ec-6833-4472-a1fa-07460edd6f16

	measure 'Prediction Icon' =
			VAR Cat = [Predicted PM2.5 Category]
			VAR G = "data:image/png;base64,"
			VAR O = "data:image/png;base64,"
			VAR R = "data:image/png;base64,"
			RETURN SWITCH ( Cat, "Good", G, "Fair", O, "Moderate", O, "Poor", R, "Very Poor", R, BLANK () )
		displayFolder: Prediction
		lineageTag: 1a16018f-831e-4114-b233-bcb33e3b3428
		dataCategory: ImageUrl

	column _
		lineageTag: db8fe3a7-664d-40a4-8d47-0fcedc10df1b
		isNameInferred
		sourceColumn: [_]

	partition _KPIs_ML = calculated
		source = ROW("_", BLANK())

