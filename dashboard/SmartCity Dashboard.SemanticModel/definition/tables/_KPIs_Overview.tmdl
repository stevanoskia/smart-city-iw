	measure 'Current Congestion' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR LatestRow = TOPN(1, 'marts fct_traffic_hourly', 'marts fct_traffic_hourly'[observed_at], DESC)
			        RETURN AVERAGEX(LatestRow, 'marts fct_traffic_hourly'[congestion_score])
			    )
			) * 100
		formatString: 0"%"
