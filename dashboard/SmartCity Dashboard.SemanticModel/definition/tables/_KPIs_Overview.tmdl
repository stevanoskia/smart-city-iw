	measure 'Active Incidents' =
			
			VAR LatestDate = CALCULATE(MAX('marts fct_traffic_daily'[date_utc]), ALLSELECTED('marts fct_traffic_daily'))
			RETURN CALCULATE(SUM('marts fct_traffic_daily'[major_incidents]), 'marts fct_traffic_daily'[date_utc] = LatestDate)
		formatString: 0
		lineageTag: b63c80d2-9deb-4b9c-8227-a0f738496326

	measure 'Rain Probability' =
			
			CALCULATE(
			    AVERAGE('marts mart_forecast_latest'[precipitation_probability]),
			    FILTER('marts mart_forecast_latest', 'marts mart_forecast_latest'[lead_time_hours] = MIN('marts mart_forecast_latest'[lead_time_hours]))
			) * 100
		formatString: 0"%"
		lineageTag: 4db88d42-12c4-489a-95d5-eee4b8f7c81a

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Last Refresh' =
			
			"Updated " & FORMAT(
			    MAXX(
			        UNION(
			            SELECTCOLUMNS('marts fct_weather_hourly', "t", 'marts fct_weather_hourly'[observed_at]),
			            SELECTCOLUMNS('marts fct_pollution_hourly', "t", 'marts fct_pollution_hourly'[observed_at]),
			            SELECTCOLUMNS('marts fct_traffic_hourly', "t", 'marts fct_traffic_hourly'[observed_at])
			        ), [t]
			    ), "dd MMM, HH:mm"
			)
		lineageTag: 0de94917-c177-48b8-ba30-9cd1381b3a28

	measure 'City Status' =
			
			VAR ActiveAlerts = CALCULATE(COUNTROWS('marts mart_pollution_alerts'), ALLSELECTED('marts mart_pollution_alerts'))
			             + CALCULATE(COUNTROWS('marts mart_weather_alerts'), ALLSELECTED('marts mart_weather_alerts'))
			RETURN IF(ActiveAlerts = 0, "Normal", ActiveAlerts & " Alert" & IF(ActiveAlerts > 1, "s", ""))
		lineageTag: 64de2c9c-3746-406a-8d5b-bb734adc8b59

	measure 'Weather Condition' =
			
			VAR M = SELECTEDVALUE('marts mart_city_current'[weather_main])
			VAR D = LOWER(SELECTEDVALUE('marts mart_city_current'[weather_description]))
			RETURN
			SWITCH(
			    TRUE(),
			    M = "Clear", "Clear Sky",
			    M = "Clouds" && CONTAINSSTRING(D, "few"), "Few Clouds",
			    M = "Clouds" && CONTAINSSTRING(D, "scattered"), "Scattered Clouds",
			    M = "Clouds" && CONTAINSSTRING(D, "broken"), "Broken Clouds",
			    M = "Clouds" && CONTAINSSTRING(D, "overcast"), "Overcast",
			    M = "Clouds", "Partly Cloudy",
			    M = "Thunderstorm" && CONTAINSSTRING(D, "light"), "Isolated Thunderstorms",
			    M = "Thunderstorm" && CONTAINSSTRING(D, "heavy"), "Severe Thunderstorm",
			    M = "Thunderstorm", "Thunderstorm",
			    M = "Drizzle" && CONTAINSSTRING(D, "light"), "Light Drizzle",
			    M = "Drizzle", "Drizzle",
			    M = "Rain" && CONTAINSSTRING(D, "light"), "Light Rain",
			    M = "Rain" && CONTAINSSTRING(D, "heavy"), "Heavy Rain",
			    M = "Rain" && CONTAINSSTRING(D, "shower"), "Rain Showers",
			    M = "Rain", "Moderate Rain",
			    M = "Snow" && CONTAINSSTRING(D, "light"), "Light Snow",
			    M = "Snow" && CONTAINSSTRING(D, "heavy"), "Heavy Snow",
			    M = "Snow" && CONTAINSSTRING(D, "sleet"), "Sleet",
			    M = "Snow", "Moderate Snow",
			    M = "Mist", "Mist",
			    M = "Fog", "Fog",
			    M = "Haze", "Haze",
			    M = "Smoke", "Smoke",
			    M = "Dust" || M = "Sand", "Dust",
			    M = "Squall", "Windy",
			    M = "Tornado", "Severe Weather",
			    SELECTEDVALUE('marts mart_city_current'[weather_description])
			)
		lineageTag: 8d636ca2-6caa-43bb-bcbd-b484b1740317

	measure 'Last Updated (City)' = VAR T = SELECTEDVALUE('marts mart_city_current'[observed_at]) RETURN IF ( ISBLANK ( T ), "All cities", "Last Updated " & FORMAT ( T, "d MMM" ) & " " & UNICHAR ( 183 ) & " " & FORMAT ( T, "HH:mm" ) )
		lineageTag: 463e1763-6e35-4323-8019-6cbf9c727bf4

	measure Sunrise = VAR T = SELECTEDVALUE('marts mart_city_current'[sunrise_at]) VAR O = SELECTEDVALUE('marts mart_city_current'[timezone_offset_sec]) RETURN IF ( ISBLANK ( T ), UNICHAR ( 8212 ), FORMAT ( T + DIVIDE ( O, 86400 ), "hh:mm AM/PM" ) )
		lineageTag: 608ef75a-4ed6-4d01-8834-a1735fdb773a

	measure Sunset = VAR T = SELECTEDVALUE('marts mart_city_current'[sunset_at]) VAR O = SELECTEDVALUE('marts mart_city_current'[timezone_offset_sec]) RETURN IF ( ISBLANK ( T ), UNICHAR ( 8212 ), FORMAT ( T + DIVIDE ( O, 86400 ), "hh:mm AM/PM" ) )
		lineageTag: da66ed78-9dc1-4cf8-bacc-bc56d7b09e1c

