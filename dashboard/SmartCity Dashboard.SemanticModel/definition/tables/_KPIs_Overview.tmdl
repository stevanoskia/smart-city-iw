	measure 'Rain Probability Previous' =
			VAR MinLead = CALCULATE(MIN('marts mart_forecast_latest'[lead_time_hours]), ALLSELECTED('marts mart_forecast_latest'))
			VAR PrevLead = CALCULATE(MIN('marts mart_forecast_latest'[lead_time_hours]), FILTER(ALLSELECTED('marts mart_forecast_latest'), 'marts mart_forecast_latest'[lead_time_hours] > MinLead))
			RETURN CALCULATE(AVERAGE('marts mart_forecast_latest'[precipitation_probability]), 'marts mart_forecast_latest'[lead_time_hours] = PrevLead) * 100
		formatString: 0"%"
		isHidden
		displayFolder: Trend Indicators
		lineageTag: fdd8147e-31fd-4ddc-8fce-adce2398bd6c

	measure 'Rain Probability Change' = [Rain Probability] - [Rain Probability Previous]
		formatString: +0;-0;0
		displayFolder: Trend Indicators
