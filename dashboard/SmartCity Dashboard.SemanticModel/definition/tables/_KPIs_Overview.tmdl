	measure 'Humidity % Previous' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR Last2 = TOPN(2, 'marts fct_weather_hourly', 'marts fct_weather_hourly'[observed_at], DESC)
			        VAR PrevRow = TOPN(1, Last2, 'marts fct_weather_hourly'[observed_at], ASC)
			        RETURN AVERAGEX(PrevRow, 'marts fct_weather_hourly'[humidity_pct])
			    )
			)
		formatString: 0"%"
		isHidden
		displayFolder: Trend Indicators
		lineageTag: 07144e1a-7b42-4eb8-9a02-e566b819b2f5

	measure 'Humidity % Change' = [Humidity %] - [Humidity % Previous]
