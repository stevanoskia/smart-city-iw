	measure 'Current Temp (°C)' =
			AVERAGEX(
			    VALUES('marts dim_city'[city]),
			    CALCULATE(
			        VAR LatestRow = TOPN(1, 'marts fct_weather_hourly', 'marts fct_weather_hourly'[observed_at], DESC)
			        RETURN AVERAGEX(LatestRow, 'marts fct_weather_hourly'[temp_celsius])
			    )
			)
		formatString: 0.0"°C"
		lineageTag: f2cf59f2-e432-4257-8984-53795664def8

		annotation PBI_FormatHint = {"isCustom":true}

