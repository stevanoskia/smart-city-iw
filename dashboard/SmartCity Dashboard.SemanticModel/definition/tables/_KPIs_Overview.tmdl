	measure 'Temp 7D vs' =
			
			CALCULATE(
			    AVERAGE('marts fct_weather_hourly'[temp_celsius]),
			    DATESINPERIOD(
			        'marts dim_date'[date_key],
			        MAX('marts dim_date'[date_key]),
			        -7,
			        DAY
			    )
			)
		formatString: 0
		lineageTag: 19fc8020-2e42-4613-b5c7-3c9ac6540d9a

	measure 'Avg Temp vs 7D' =
			
			VAR CurrTemp = AVERAGE('marts fct_weather_hourly'[temp_celsius])
			VAR Avg7D = [Temp 7D vs]
			VAR _perc = DIVIDE(CurrTemp - Avg7D, Avg7D, 0)
			VAR _format = FORMAT(_perc, "0.0%;0.0%;0.0%")
			RETURN
			SWITCH(
			    TRUE(),
			    _perc > 0, UNICHAR(11165) & " " & _format,
			    _perc < 0, UNICHAR(11167) & " " & _format,
			    "→ 0.0%"
			)
		isHidden
		lineageTag: b509c5ec-9d8d-4f7b-b36a-1e6723bdf3bb

	measure 'Comfort Index Previous' = AVERAGE('marts mart_city_daily'[prior_7d_comfort])
