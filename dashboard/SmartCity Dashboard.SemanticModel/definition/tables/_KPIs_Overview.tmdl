			SWITCH(
			    TRUE(),
			    _chg > 0, UNICHAR(11165) & " " & FORMAT(_chg, "+0") & "pp",
			    _chg < 0, UNICHAR(11167) & " " & FORMAT(_chg, "0") & "pp",
